# run with --cap-add sys_admin --security-opt label=disable --squash
ARG BASE_IMAGE=ghcr.io/lyranile/manganite:latest
FROM ${BASE_IMAGE}
ENV BASE_IMAGE=${BASE_IMAGE}

COPY iso/iso_files/ /src/iso_files/
RUN --mount=type=cache,target=/var/cache/libdnf5,id=libdnf5 \
    --mount=type=tmpfs,dst=/var \
    bash /src/iso_files/build.sh
