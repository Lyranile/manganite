export HOMEBREW_NO_ENV_HINTS=1

# Zinit
ZINIT_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"
source "$ZINIT_HOME/zinit.zsh"
fpath+="$HOME/.zfunc"

# History
HISTFILE=$HOME/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

# Options
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt AUTO_CD
setopt COMPLETE_IN_WORD
setopt AUTO_MENU
setopt INTERACTIVE_COMMENTS

# Oh My Zsh Plugins
zinit wait lucid for \
  OMZL::completion.zsh \
  OMZL::directories.zsh \
  OMZL::history.zsh \
  OMZP::git \
  OMZP::kubectl \
  OMZP::docker-compose \
  OMZP::aws \
  OMZP::terraform \
  OMZP::helm \
  OMZP::kubectx \
  OMZP::command-not-found \
  OMZP::sudo

_setup_history_substring_keys() {
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
}

_setup_instructions() {
  zicompinit
  zicdreplay
}

# Command Completions
zinit ice wait lucid blockf
zinit light zsh-users/zsh-completions

# Command Autosuggestions
zinit ice wait lucid atload'_zsh_autosuggest_start'
zinit light zsh-users/zsh-autosuggestions

# Substring Search
zinit ice wait lucid atload'_setup_history_substring_keys'
zinit light zsh-users/zsh-history-substring-search

# Syntax Highlighting
zinit ice wait lucid
zinit light zdharma-continuum/fast-syntax-highlighting

# Bracket Closing
zinit ice wait lucid
zinit light hlissner/zsh-autopair

# Aliased Commands
zinit ice wait lucid
zinit light MichaelAquilina/zsh-you-should-use

# Shift Selection
zinit ice wait lucid
zinit light jirutka/zsh-shift-select

# Styles
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Bindkeys
bindkey -e

# Word movement
bindkey '^[f' forward-word
bindkey '^[b' backward-word

# Terminal compatibility
bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[[3~" delete-char

# Word navigation
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word
bindkey "^[f" forward-word
bindkey "^[b" backward-word

# History search
bindkey "^[[A" history-search-backward
bindkey "^[[B" history-search-forward

# Home/End fallback
bindkey "\e[H" beginning-of-line
bindkey "\e[F" end-of-line

# Tab navigation
bindkey "^I" menu-complete
bindkey "\e[Z" reverse-menu-complete

# Compute Initialization
autoload -Uz compinit
rm -f ~/.zcompdump
compinit

# Profile Loading
fpath+=~/.zfunc; autoload -Uz compinit; compinit

# --- managed env/aliases (from former .profile) ---
SHELL=$(cat /proc/$$/comm)

if [ "$(command -v starship)" ]; then
	eval "$(starship init "${SHELL}")"
	eval "$(starship completions "${SHELL}")"
fi

if [ "$(command -v eza)" ]; then
	FLAGS="--git --icons=auto --classify --group-directories-first --time-style=long-iso --color-scale"
	alias ls='eza $FLAGS'
	alias l='eza $FLAGS --git-ignore'
	alias ll='eza $FLAGS --all --header --long'
	alias tree='eza $FLAGS --tree'
fi

if [ "$(command -v zoxide)" ]; then
	eval "$(zoxide init "${SHELL}")"
	alias cd="z"
fi

if [ "$(command -v fzf)" ]; then
	eval "$(fzf --"${SHELL}")"
fi

if [ "$(command -v atuin)" ]; then
	eval "$(atuin init "${SHELL}")"
fi

if [ "$(command -v bat)" ]; then
	alias less="bat"
	alias cat="bat --paging=never"
fi

if [ "$(command -v procs)" ]; then
    alias ps='procs'
fi

if [ "$(command -v uv)" ]; then
    alias pip='uv'
fi

if [ "$(command -v npm)" ]; then
    alias npm='pnpm'
fi
