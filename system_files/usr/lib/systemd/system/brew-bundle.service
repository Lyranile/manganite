[Unit]
Description=Install default Homebrew bundle
Wants=brew-setup.service
After=brew-setup.service network-online.target
Before=greetd.service
ConditionPathExists=/usr/share/ublue-os/Brewfile

[Service]
Type=oneshot
User=1000
Environment=HOMEBREW_CELLAR=/home/linuxbrew/.linuxbrew/Cellar
Environment=HOMEBREW_PREFIX=/home/linuxbrew/.linuxbrew
Environment=HOMEBREW_REPOSITORY=/home/linuxbrew/.linuxbrew/Homebrew
ExecStart=/home/linuxbrew/.linuxbrew/bin/brew bundle --file=/usr/share/ublue-os/Brewfile
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
