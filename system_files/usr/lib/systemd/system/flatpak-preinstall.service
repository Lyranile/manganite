[Unit]
Description=Install preinstalled Flatpaks
Documentation=man:flatpak-preinstall(1)
Wants=network-online.target
After=network-online.target flatpak-add-fedora-repos.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/flatpak preinstall -y --noninteractive

[Install]
WantedBy=multi-user.target
