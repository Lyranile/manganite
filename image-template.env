# General
IMAGE_NAME="manganite"
REPO_ORGANIZATION="lyranile"
IMAGE_DESC="A minimal Umbriel + Noctalia bootc image layered on the Universal Blue base"
IMAGE_KEYWORDS="umbriel,noctalia,wayland,tiling,rice,ublue"
IMAGE_LOGO_URL="https://raw.githubusercontent.com/Lyranile/manganite/main/system_files/usr/share/icons/hicolor/scalable/apps/manganite.svg"
DEFAULT_TAG="latest"

# Sources
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
BASE_IMAGE_NAME="base-main"
BASE_IMAGE_TAG="44"

# NVIDIA_VARIANT="none" builds the plain base-main image.
# Any other value (e.g. "proprietary" or "open") layers prebuilt NVIDIA akmods
# (akmods-nvidia-open for Fedora 44, which carries the open kernel modules + NVK)
# and pins the kernel to the version the modules were built against.
NVIDIA_VARIANT="proprietary"
