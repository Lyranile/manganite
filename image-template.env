IMAGE_NAME="manganite"
REPO_ORGANIZATION="lyranile"
IMAGE_DESC="A minimal KDE + mangowm + Noctalia bootc image layered on the Kinoite NVIDIA base"
IMAGE_KEYWORDS="mangowm,noctalia,kde,kinoite,wayland,rice,ublue"
